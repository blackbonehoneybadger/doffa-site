# Конфигурация выпуска $DOFFA. Скопируй в .env и заполни.
#   Windows: copy .env.example .env
#   macOS:   cp .env.example .env
#
# ⚠️ .env и owner.json — секретные. Они в .gitignore и НЕ попадают в GitHub.

# Сеть: devnet (тест, бесплатно) или mainnet-beta (боевая, за реальные SOL).
CLUSTER=devnet

# RPC-узел. Пусто → публичный узел выбранной сети.
RPC_URL=

# Файл с приватным ключом, которым подписываются транзакции.
# Создаётся командой npm run keygen, либо npm run import (свой Phantom).
KEYPAIR_PATH=./owner.json

# Параметры токена.
TOKEN_NAME=DOFFA
TOKEN_SYMBOL=DOFFA
TOKEN_DECIMALS=6
TOKEN_SUPPLY=100000000

# Ссылка на метаданные токена (логотип + описание) на Arweave/IPFS.
METADATA_URI=

# Кому уходит вся эмиссия при создании.
# ⚠️ На mainnet ОБЯЗАТЕЛЬНО укажи свой основной кошелёк (Phantom).
# Если оставить пусто, токены останутся на служебном ключе из owner.json —
# именно так теряется доступ к деньгам.
RECIPIENT_ADDRESS=

# Адрес уже выпущенного токена (для verify/burn/revoke).
# Пусто → берётся из .doffa-mint.json, который создаёт npm run create.
MINT_ADDRESS=

# ДВОЙНОЙ предохранитель mainnet-записи. Не сохраняй подтверждение здесь.
# Для каждой create/burn/revoke операции задай его только в текущем терминале
# и одновременно передай --confirm-mainnet=<ТОЧНЫЙ_MINT> (для create:
# --confirm-mainnet=CREATE_NEW_MINT). Подробные команды — в README.
DOFFA_MAINNET_CONFIRMATION=
