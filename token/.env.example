# Конфигурация выпуска нового токена DOFFA. Скопируй в .env и заполни.
#   Windows: copy .env.example .env
#   macOS:   cp .env.example .env
#
# ⚠️ .env и файл ключа — секретные. Они в .gitignore и в GitHub не попадают.
#    Приватный ключ НИКОГДА не пишется сюда и не передаётся никому, включая
#    разработчиков и ассистента. Здесь только путь к файлу ключа.

# ── Сеть ────────────────────────────────────────────────────────────────────
# devnet       — тестовая, бесплатно, для репетиции.
# mainnet-beta — боевая, за реальные SOL, необратимо.
DOFFA_CLUSTER=devnet

# RPC-узел. Пусто → публичный узел выбранной сети.
DOFFA_RPC_URL=

# ── Параметры токена ────────────────────────────────────────────────────────
# Менять их нельзя: скрипты сверяют фактическое состояние в сети с этими
# значениями и падают при расхождении.
DOFFA_NAME=DOFFA
DOFFA_SYMBOL=DOFFA
DOFFA_SUPPLY=100000000
DOFFA_DECIMALS=6

# ── Кошелёк владельца ───────────────────────────────────────────────────────
# Единственный управляемый кошелёк проекта. Вся эмиссия уходит на него.
# На mainnet скрипты требуют, чтобы подписывающий ключ принадлежал именно
# этому адресу — иначе выпуск не начнётся.
DOFFA_OWNER_WALLET=E4tvCMvkrpMeVKE8SvcLgxk6D2jovQ3SB97s2umSwLUr

# Путь к файлу ключа, которым подписываются транзакции.
# Файл создаётся локально и НИКУДА не выкладывается.
DOFFA_KEYPAIR_PATH=./owner.json

# ── Метаданные ──────────────────────────────────────────────────────────────
# Ссылка на JSON с логотипом и описанием. ТОЛЬКО постоянное хранилище:
# IPFS или Arweave. Временный URL (Vercel, ngrok, свой сервер) использовать
# нельзя: после отзыва authority этот URI уже не переписать, и токен навсегда
# останется без логотипа.
DOFFA_METADATA_URI=

# ── Адрес нового mint ───────────────────────────────────────────────────────
# ⚠️ Заранее НЕ заполнять. Появляется после `npm run token:create` и
#    записывается автоматически в token/deploy-output/<cluster>.json
DOFFA_MINT_ADDRESS=
