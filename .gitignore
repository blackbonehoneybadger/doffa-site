# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Шаблоны без значений — их коммитить нужно, иначе инструкция «скопируй
# .env.example в .env» отсылает к файлу, которого нет в репозитории.
# Настоящие секреты живут в .env / .env.local и остаются игнорируемыми.
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Ключи Solana ────────────────────────────────────────────────────────────
# Widely-cast маски: раньше защищено было ровно одно имя (token/owner.json), и
# ключ, сохранённый под любым другим именем, ушёл бы в коммит. Проект уже терял
# 1 000 000 $DOFFA из-за плохой работы с ключами — второй раз нельзя.
*owner*.json
*keypair*.json
*.key.json
id.json
*-key.json
/token/.doffa-*.json
/token/deploy-output/

# ── Ключи, секреты, учётные данные ──────────────────────────────────────────
# Широкие маски: раньше защищено было ровно одно имя (token/owner.json), и
# ключ под любым другим именем ушёл бы в коммит. Проект уже терял 1 000 000
# DOFFA из-за плохой работы с ключами — второй раз нельзя.
*.key
*.pem
*.secret
wallet*.json
keypair*.json
*keypair*.json
*owner*.json
*-key.json
*.key.json
id.json
solana-keypair*
credentials*
/token/.doffa-*.json
/token/deploy-output/

# Печатный лист резервной копии ключа — содержит приватный ключ открытым
# текстом. Создаётся token:backup-sheet локально, печатается и удаляется.
doffa-key-backup.html
*key-backup*.html
