# ============================================================
#  DOFFA POS-бот — переменные окружения
#  Скопируй этот файл в .env (локально) ИЛИ впиши значения
#  в Railway → вкладка Variables.
# ============================================================

# --- Telegram ---------------------------------------------

# Токен бота от @BotFather. Пример: 1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxx
DOFFA_BOT_TOKEN=

# ID администраторов через запятую (твой Telegram ID). Узнать ID: @userinfobot
# Только эти люди смогут открывать смену и пробивать продажи.
ADMIN_IDS=

# Куда писать базу продаж. Локально ./data/doffa.db
# На Railway укажи путь к Volume: /data/doffa.db
DB_PATH=./data/doffa.db

# Сколько токенов сжигать за 1 чашку кофе. По умолчанию 1.
BURN_PER_CUP=1

# Секретный ключ кошелька-владельца токена — JSON-массив из 64 байт: [12,34,...]
# Лежит в файле token/owner.json. Скопируй ВСЁ содержимое этого файла.
OWNER_KEYPAIR=

# ============================================================
#  ЭТАП 1 — ТЕСТ на devnet (бесплатно, ничего не стоит)
#  Сейчас используем эти два значения:
# ============================================================
DOFFA_MINT=FVERje4sz25gD1w4hTYV5VevSLPPDFhoNDHax1gvMVKU
SOLANA_RPC=https://api.devnet.solana.com

# ============================================================
#  ЭТАП 2 — БОЕВОЙ запуск на mainnet (за реальные деньги)
#  Когда тест пройдёт — создадим mainnet-токен и заменим
#  две строки выше на настоящие значения, например:
#    DOFFA_MINT=<адрес mainnet-токена>
#    SOLANA_RPC=https://api.mainnet-beta.solana.com
#  (для надёжности лучше платный RPC: Helius / QuickNode)
# ============================================================
