# Токен бота от @BotFather (Telegram). Пример: 1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxx
DOFFA_BOT_TOKEN=

# ID администраторов через запятую (твой Telegram ID). Узнать ID: напиши @userinfobot
# Только эти люди смогут открывать смену и пробивать продажи.
ADMIN_IDS=

# Куда писать базу продаж. По умолчанию ./data/doffa.db
# На Railway укажи путь к Volume, например /data/doffa.db
DB_PATH=./data/doffa.db

# Главный адрес токена $DOFFA (mainnet). Менять нельзя — это адрес проекта.
DOFFA_MINT=6cAtKTM8ZPUgRgmzsgkRfZsq4jZTXymA7cLqjz9qYMFS

# Сколько токенов сжигать за 1 чашку кофе. По умолчанию 1.
BURN_PER_CUP=1
